{
  "name": "simutown",
  "version": "0.1.0",
  "description": "Script small pixel-town scenes that explain ideas, and play them in a browser or render them to video. Like manim, for a little town of people.",
  "keywords": [
    "pixel-art",
    "animation",
    "explainer",
    "manim",
    "simulation",
    "town",
    "video",
    "typescript"
  ],
  "homepage": "https://github.com/vdcmathieu/simutown#readme",
  "bugs": "https://github.com/vdcmathieu/simutown/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vdcmathieu/simutown.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/types/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./player": {
      "types": "./dist/types/player/index.d.ts",
      "default": "./dist/player/index.js"
    },
    "./towns": {
      "types": "./dist/types/towns/index.d.ts",
      "default": "./dist/towns/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "simutown": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "!dist/web",
    "docs/*.md"
  ],
  "sideEffects": [
    "./dist/cli/bin.js"
  ],
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "build": "tsx tools/build.ts",
    "prepare": "tsx tools/build.ts",
    "test:package": "tsx tools/test-package.ts",
    "sheet": "tsx tools/sheet.ts",
    "still": "tsx tools/still.ts",
    "simutown": "tsx src/cli/bin.ts",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
